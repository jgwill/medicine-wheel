{
  "name": "@medicine-wheel/infra",
  "version": "0.5.8",
  "description": "Typed infrastructure facets for the Medicine Wheel Developer Suite — hosts, tenants, services, and port bindings as facets keyed by relational node id, with port-conflict detection over declared ∪ observed state",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js",
      "require": "./dist/types.js",
      "default": "./dist/types.js"
    },
    "./schemas": {
      "types": "./dist/schemas.d.ts",
      "import": "./dist/schemas.js",
      "require": "./dist/schemas.js",
      "default": "./dist/schemas.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "keywords": [
    "medicine-wheel",
    "infrastructure",
    "systemd",
    "relational-ontology",
    "port-conflict",
    "topology-as-data",
    "metis"
  ],
  "author": "IAIP Collaborative - Shawinigan, QC",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jgwill/medicine-wheel.git",
    "directory": "src/infra"
  },
  "dependencies": {
    "@medicine-wheel/ontology-core": "^0.5.8",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0"
  }
}
