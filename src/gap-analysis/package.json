{
  "name": "@medicine-wheel/gap-analysis",
  "version": "0.10.0",
  "description": "Problem-solving built properly for when something worked and stopped: evidenced baseline, observation, difference, verifiable elimination steps. Root cause, incidents, regressions, troubleshooting. The baseline requirement is what separates a fire from a creating act.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "ALPHA.md"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "keywords": [
    "gap-analysis",
    "problem-solving",
    "root-cause",
    "incident-response",
    "postmortem",
    "regression",
    "troubleshooting",
    "debugging",
    "fix",
    "baseline",
    "creative-orientation",
    "medicine-wheel"
  ],
  "author": "jgwill",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jgwill/medicine-wheel.git",
    "directory": "src/gap-analysis"
  },
  "dependencies": {
    "@medicine-wheel/creative-orientation": "^0.10.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  }
}
