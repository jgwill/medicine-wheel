{
  "name": "@medicine-wheel/capabilities",
  "version": "0.24.0",
  "description": "The platform-features and capabilities layer of the Medicine Wheel Developer Suite — what the platform can do, which repositories and services provide it, who said so and from what, with the 55-word statement limit and shared-capability detection",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "keywords": [
    "medicine-wheel",
    "capabilities",
    "platform-features",
    "developer-suite",
    "relational-ontology",
    "inventory"
  ],
  "author": "IAIP Collaborative - Shawinigan, QC",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jgwill/medicine-wheel.git",
    "directory": "src/capabilities"
  },
  "dependencies": {
    "@medicine-wheel/infra": "^0.24.0",
    "@medicine-wheel/ontology-core": "^0.24.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0"
  }
}
