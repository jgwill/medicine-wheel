    "beatWitnessed": {
      "title": "medicine-wheel.beat.witnessed",
      "description": "A beat gained a witness, or its speaker was named. Written by: PATCH /api/narrative/beats/{id}. Correlation: the beat's cycle, else its first ceremony.",
