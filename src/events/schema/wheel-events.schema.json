{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Medicine Wheel events",
  "description": "Every event a Medicine Wheel writes to events.jsonl and will publish. Catalog 0.2.0, envelope MiadiEventEnvelope 0.1.0.",
  "definitions": {
    "envelope": {
      "title": "MiadiEventEnvelope (Medicine Wheel)",
      "description": "A Medicine Wheel event in jgwill/Miadi's MiadiEventEnvelope 0.1.0. The payload carries references and labels, never a person's words.",
      "type": "object",
      "required": [
        "id",
        "schema_version",
        "event_type",
        "source",
        "subject",
        "occurred_at",
        "observed_at",
        "idempotency_key",
        "privacy",
        "payload"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^mwev:",
          "description": "Stable identity of this occurrence."
        },
        "schema_version": {
          "type": "string",
          "const": "0.1.0"
        },
        "event_type": {
          "type": "string",
          "pattern": "^medicine\\-wheel\\.",
          "description": "The namespaced event name; also its topic."
        },
        "source": {
          "type": "object",
          "required": [
            "kind",
            "system"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "const": "miadi"
            },
            "system": {
              "type": "string",
              "const": "medicine-wheel"
            },
            "instance": {
              "type": "string",
              "description": "The wheel that observed it, as configured (MW_INSTANCE)."
            }
          }
        },
        "subject": {
          "type": "object",
          "required": [
            "kind",
            "id"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "cycle",
                "beat",
                "ceremony",
                "diary",
                "node",
                "relation"
              ]
            },
            "id": {
              "type": "string",
              "minLength": 1,
              "description": "The record the event is about; read it back from the wheel by this id."
            }
          }
        },
        "occurred_at": {
          "type": "string",
          "format": "date-time"
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "actor": {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "type": "string"
            },
            "id": {
              "type": "string"
            }
          },
          "description": "Who acted, when the record names them: a speaker, a participant, a source, a judge."
        },
        "correlation_id": {
          "type": "string",
          "description": "Groups related events: a cycle and the beats recorded in it, a ceremony and its closing."
        },
        "causation_id": {
          "type": "string",
          "description": "The event that directly led to this one."
        },
        "idempotency_key": {
          "type": "string",
          "description": "Equal to id. A resend is the same occurrence."
        },
        "privacy": {
          "type": "object",
          "required": [
            "classification",
            "content_included"
          ],
          "properties": {
            "classification": {
              "type": "string"
            },
            "content_included": {
              "type": "boolean"
            }
          }
        },
        "payload": {
          "type": "object"
        }
      }
    },
    "cycleOpened": {
      "title": "medicine-wheel.cycle.opened",
      "description": "A research cycle was opened. Written by: POST /api/narrative/cycles with a new id; MCP create_research_cycle. Correlation: the cycle.",
      "allOf": [
        {
          "$ref": "#/definitions/envelope"
        },
        {
          "properties": {
            "event_type": {
              "const": "medicine-wheel.cycle.opened"
            },
            "subject": {
              "properties": {
                "kind": {
                  "const": "cycle"
                }
              }
            },
            "payload": {
              "type": "object",
              "properties": {
                "current_direction": {
                  "type": "string",
                  "description": "The direction the cycle starts in."
                }
              },
              "required": [
                "current_direction"
              ]
            }
          }
        }
      ]
    },
    "cycleAmended": {
      "title": "medicine-wheel.cycle.amended",
      "description": "A research cycle changed: its question, its direction, its counts. Written by: POST /api/narrative/cycles with a known id; MCP update_cycle_direction. A cycle's beats list follows from beat.recorded and is not an amendment.. Correlation: the cycle.",
      "allOf": [
        {
          "$ref": "#/definitions/envelope"
        },
        {
          "properties": {
            "event_type": {
              "const": "medicine-wheel.cycle.amended"
            },
            "subject": {
              "properties": {
                "kind": {
                  "const": "cycle"
                }
              }
            },
            "payload": {
              "type": "object",
              "properties": {
                "changed": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "The fields the write changed. Metadata keys appear as `metadata.<key>`."
                },
                "current_direction": {
                  "type": "string",
                  "description": "The direction the cycle now stands in."
                }
              },
              "required": [
                "changed",
                "current_direction"
              ]
            }
          }
        }
      ]
    },
    "cycleArchived": {
      "title": "medicine-wheel.cycle.archived",
      "description": "A research cycle was archived for the seven generations. Written by: POST /api/narrative/cycles with `archived: true`; MCP archive_for_seven_generations. Correlation: the cycle.",
      "allOf": [
        {
          "$ref": "#/definitions/envelope"
        },
        {
          "properties": {
            "event_type": {
              "const": "medicine-wheel.cycle.archived"
            },
            "subject": {
              "properties": {
                "kind": {
                  "const": "cycle"
                }
              }
            },
            "payload": {
              "type": "object",
              "properties": {}
            }
          }
        }
      ]
    },
    "beatRecorded": {
      "title": "medicine-wheel.beat.recorded",
      "description": "A narrative beat was recorded — in a talking circle, a turn was spoken. Written by: POST /api/narrative/beats with a new id; MCP create_narrative_beat, create_sub_beats. Correlation: the beat's cycle, else its first ceremony.",
      "allOf": [
        {
          "$ref": "#/definitions/envelope"
        },
        {
          "properties": {
            "event_type": {
              "const": "medicine-wheel.beat.recorded"
            },
            "subject": {
              "properties": {
                "kind": {
                  "const": "beat"
                }
              }
            },
            "payload": {
              "type": "object",
              "properties": {
                "direction": {
                  "type": "string",
                  "description": "The direction the beat stands in."
                },
                "act": {
                  "type": "number",
                  "description": "The act, derived from the direction."
                },
                "cycle_id": {
                  "type": "string",
                  "description": "The research cycle the beat belongs to."
                },
                "parent_beat_id": {
                  "type": "string",
                  "description": "The beat this one was telescoped out of."
                },
                "ceremonies": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "Ceremonies the beat was spoken in."
                },
                "origin": {
                  "type": "string",
                  "description": "Who or what put the beat on the wheel (`hand`, `rest`, `session-reader`, …)."
                }
              },
              "required": [
                "direction",
                "act"
              ]
            }
          }
        }
      ]
    },
    "beatAmended": {
      "title": "medicine-wheel.beat.amended",
