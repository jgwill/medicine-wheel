                "circle_id": {
                  "type": "string",
                  "description": "The circle node the ceremony is held in."
                },
                "subject_id": {
                  "type": "string",
                  "description": "The node the ceremony gathers around (a review, a knowledge node)."
                },
                "episode_path": {
                  "type": "string",
                  "description": "The chronicle episode folder the ceremony belongs to."
                },
                "episode_number": {
                  "type": "number",
                  "description": "That episode's number."
                }
              },
              "required": [
